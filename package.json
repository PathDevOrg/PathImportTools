{
  "name": "aura-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aura-importer/web",
    "build": "npm run build -w @aura-importer/aura-schema && npm run build -w @aura-importer/converter && npm run build -w @aura-importer/web",
    "test": "vitest run",
    "security:deps": "node scripts/check-supply-chain.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test:smoke": "node scripts/smoke-web.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "npm run preview -w @aura-importer/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.51.2-build6",
    "fflate": "^0.8.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
