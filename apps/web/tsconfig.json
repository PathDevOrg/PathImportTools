{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist-ts",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@aura-importer/converter": ["../../packages/converter/src/index.ts"],
      "@aura-importer/aura-schema": ["../../packages/aura-schema/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/converter"
    }
  ]
}
